*{
    font-family: Georgia;
}

QMainWindow, QWidget{
    background-color: #252525;
    color: mintcream;
}

QScrollArea{
    border: 1px solid mintcream;

}

QPushButton{
    border-radius: 1em;
    border: 0.5px solid #ffb1dd;
    background-color: #333333;
    padding: 0.5em 1.5em;
}

QPushButton:hover{
    border-width: 1px;
    color: #ffb1dd;
    background-color: #383838;
}

QPushButton:pressed{
    border-width: 0.5px;
    border-color: pink;
    color: #d394b8;
    background-color: #252525;
}


QLineEdit{
  color: mintcream;
  border: 1px solid dodgerblue;
  border-radius: 10px;
  padding: 10px 25px;
  background: transparent;
  max-width: 190px;
}
QLineEdit:focus{
    border-width: 1.5px;
}

